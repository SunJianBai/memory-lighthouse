# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=13100
CORS_ORIGINS=http://127.0.0.1:4310,http://localhost:4310
PUBLIC_APP_URL=http://127.0.0.1:4310/openBMB

# Outbound mail. Development/test default to an in-process memory outbox.
# Production requires smtp plus every SMTP credential below and verifies the
# connection before the API becomes ready. For local Mailpit, use smtp,
# 127.0.0.1:1025, SMTP_SECURE=false, and SMTP_REQUIRE_TLS=false.
MAIL_DELIVERY_MODE=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=守忆灯塔
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# MySQL / Prisma
DATABASE_URL=mysql://openbmb:REPLACE_WITH_MYSQL_PASSWORD@127.0.0.1:13306/openbmb
# Development migration only; do not grant CREATE DATABASE to the runtime user.
SHADOW_DATABASE_URL=mysql://openbmb:REPLACE_WITH_MYSQL_PASSWORD@127.0.0.1:13306/openbmb_shadow

# Redis
REDIS_URL=redis://openbmb-api:REPLACE_WITH_REDIS_APP_PASSWORD@127.0.0.1:16379/0
# Canonical base64url for at least 32 random bytes; independent from auth/device peppers.
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_REDIS_PREFIX=openbmb:rate-limit:v1
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=5000
# Set to 1 only when the API is bound to loopback behind the local Caddy hop.
RATE_LIMIT_TRUST_PROXY_HOPS=0

# Object storage
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=openbmb-assets
OBJECT_STORAGE_ACCESS_KEY_ID=openbmb-api
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_APP_SECRET_KEY
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Auth — generate each secret independently; never reuse infrastructure secrets.
AUTH_ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_REFRESH_TOKEN_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_ONE_TIME_TOKEN_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
HOUSEHOLD_INVITATION_TOKEN_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
HOUSEHOLD_INVITATION_TTL_SECONDS=604800
# Device peppers must be canonical base64url values decoding to at least 32 bytes.
DEVICE_ACTIVATION_PEPPER=
DEVICE_CREDENTIAL_PEPPER=
DEVICE_ACCESS_TOKEN_SECRET=
DEVICE_ACCESS_TOKEN_TTL_SECONDS=600
DEVICE_ACTIVATION_CHALLENGE_TTL_SECONDS=300
DEVICE_ACTIVATION_MAX_ATTEMPTS=5
DEVICE_CREDENTIAL_TTL_SECONDS=2592000

# Application-level encryption. Keys are independent from auth and storage.
DATA_ENCRYPTION_KEY_BASE64=REPLACE_WITH_EXACTLY_32_BYTES_IN_BASE64
DATA_ENCRYPTION_KEY_ID=dev-key-1
CARE_WORKFLOW_ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_BYTES_IN_BASE64URL
CARE_WORKFLOW_SCHEDULER_ENABLED=true
CARE_WORKFLOW_SCHEDULER_INTERVAL_MS=60000
CARE_WORKFLOW_GENERATION_HORIZON_HOURS=24
TRANSCRIPT_RETENTION_DAYS=30
TRANSCRIPT_PURGE_ENABLED=true
TRANSCRIPT_PURGE_INTERVAL_MS=300000
TRANSCRIPT_PURGE_BATCH_SIZE=100

# Realtime media control plane
LIVEKIT_URL=ws://127.0.0.1:17880
# Browser/Android clients connect to this URL. Production must use wss://.
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:17880
LIVEKIT_API_KEY=openbmb_api
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET
DEVICE_ONLINE_THRESHOLD_SECONDS=120
REMOTE_SESSION_EXPIRY_ENABLED=true
REMOTE_SESSION_EXPIRY_INTERVAL_MS=15000
REMOTE_RING_TIMEOUT_SECONDS=60
REMOTE_CONNECT_TIMEOUT_SECONDS=180

# MiniCPM and ASR adapters. Remote family calls never use ASR.
MINICPM_PROVIDER=modelbest
MINICPM_REALTIME_URL=wss://minicpmo45.modelbest.cn/v1/realtime
MINICPM_API_KEY=
ASR_PROVIDER=sherpa-onnx
ASR_PRIVATE_URL=ws://127.0.0.1:18082/stream

# Development-only content inspection. Production must be false.
ENABLE_DEVELOPMENT_CONTENT_INSPECTION=false
