model RemoteAccessPolicy {
  id                     String    @id @db.Char(26)
  householdId            String    @map("household_id") @db.Char(26)
  recipientId            String    @map("recipient_id") @db.Char(26)
  bindingId              String    @unique @map("binding_id") @db.Char(26)
  mode                   String    @db.VarChar(32)
  cameraAllowed          Boolean   @default(false) @map("camera_allowed")
  microphoneAllowed      Boolean   @default(true) @map("microphone_allowed")
  sendFamilyAudioAllowed Boolean   @default(true) @map("send_family_audio_allowed")
  countdownSeconds       Int       @default(10) @map("countdown_seconds")
  validFrom              DateTime  @map("valid_from") @db.DateTime(3)
  validUntil             DateTime? @map("valid_until") @db.DateTime(3)
  localConfirmedAt       DateTime? @map("local_confirmed_at") @db.DateTime(3)
  consentEventId         String?   @map("consent_event_id") @db.Char(26)
  status                 String    @db.VarChar(32)
  createdAt              DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  version                Int       @default(0)

  binding  CompanionBinding           @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  members  RemoteAccessPolicyMember[]
  sessions RemoteAssistanceSession[]

  @@index([householdId, recipientId, status])
  @@map("remote_access_policies")
}

model RemoteAccessPolicyMember {
  policyId            String    @map("policy_id") @db.Char(26)
  householdMemberId   String    @map("household_member_id") @db.Char(26)
  allowedVideo        Boolean   @default(false) @map("allowed_video")
  allowedReceiveAudio Boolean   @default(true) @map("allowed_receive_audio")
  allowedSendAudio    Boolean   @default(true) @map("allowed_send_audio")
  validUntil          DateTime? @map("valid_until") @db.DateTime(3)
  revokedAt           DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  policy RemoteAccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  member HouseholdMember    @relation(fields: [householdMemberId], references: [id], onDelete: Cascade)

  @@id([policyId, householdMemberId])
  @@index([householdMemberId, revokedAt])
  @@map("remote_access_policy_members")
}

model RemoteAssistanceSession {
  id                  String    @id @db.Char(26)
  householdId         String    @map("household_id") @db.Char(26)
  recipientId         String    @map("recipient_id") @db.Char(26)
  bindingId           String    @map("binding_id") @db.Char(26)
  initiatedByMemberId String    @map("initiated_by_member_id") @db.Char(26)
  accessPolicyId      String?   @map("access_policy_id") @db.Char(26)
  answerMode          String    @map("answer_mode") @db.VarChar(32)
  requestedMedia      String    @map("requested_media") @db.VarChar(32)
  status              String    @db.VarChar(32)
  livekitRoomName     String    @unique @map("livekit_room_name") @db.VarChar(128)
  requestedAt         DateTime  @map("requested_at") @db.DateTime(3)
  acceptedAt          DateTime? @map("accepted_at") @db.DateTime(3)
  connectedAt         DateTime? @map("connected_at") @db.DateTime(3)
  endedAt             DateTime? @map("ended_at") @db.DateTime(3)
  endedByType         String?   @map("ended_by_type") @db.VarChar(16)
  endedById           String?   @map("ended_by_id") @db.Char(26)
  endReason           String?   @map("end_reason") @db.VarChar(64)
  consentSnapshotJson Json      @map("consent_snapshot_json")
  traceId             String    @map("trace_id") @db.VarChar(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  version             Int       @default(0)

  household    Household                  @relation(fields: [householdId], references: [id], onDelete: Restrict)
  recipient    CareRecipient              @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  binding      CompanionBinding           @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  accessPolicy RemoteAccessPolicy?        @relation(fields: [accessPolicyId], references: [id], onDelete: SetNull)
  participants RemoteSessionParticipant[]
  events       RemoteSessionEvent[]

  @@index([bindingId, status, requestedAt])
  @@index([householdId, requestedAt])
  @@map("remote_assistance_sessions")
}

model RemoteSessionParticipant {
  id             String    @id @db.Char(26)
  sessionId      String    @map("session_id") @db.Char(26)
  principalType  String    @map("principal_type") @db.VarChar(16)
  userId         String?   @map("user_id") @db.Char(26)
  bindingId      String?   @map("binding_id") @db.Char(26)
  role           String    @db.VarChar(16)
  clientType     String    @map("client_type") @db.VarChar(16)
  joinedAt       DateTime? @map("joined_at") @db.DateTime(3)
  leftAt         DateTime? @map("left_at") @db.DateTime(3)
  publishedAudio Boolean   @default(false) @map("published_audio")
  publishedVideo Boolean   @default(false) @map("published_video")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  session RemoteAssistanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, joinedAt])
  @@map("remote_session_participants")
}

model RemoteSessionEvent {
  id           String   @id @db.Char(26)
  sessionId    String   @map("session_id") @db.Char(26)
  eventType    String   @map("event_type") @db.VarChar(64)
  actorType    String?  @map("actor_type") @db.VarChar(16)
  actorId      String?  @map("actor_id") @db.Char(26)
  metadataJson Json?    @map("metadata_json")
  occurredAt   DateTime @map("occurred_at") @db.DateTime(3)

  session RemoteAssistanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, occurredAt])
  @@map("remote_session_events")
}

model InspectionGrant {
  id                 String    @id @db.Char(26)
  environment        String    @db.VarChar(16)
  requestedByUserId  String    @map("requested_by_user_id") @db.Char(26)
  approvedByUserId   String?   @map("approved_by_user_id") @db.Char(26)
  householdId        String    @map("household_id") @db.Char(26)
  recipientId        String?   @map("recipient_id") @db.Char(26)
  dataCategoriesJson Json      @map("data_categories_json")
  reason             String    @db.VarChar(1000)
  ticketReference    String?   @map("ticket_reference") @db.VarChar(100)
  status             String    @db.VarChar(32)
  validFrom          DateTime  @map("valid_from") @db.DateTime(3)
  expiresAt          DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt          DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  requestedBy User                @relation("InspectionGrantRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy  User?               @relation("InspectionGrantApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Restrict)
  recipient   CareRecipient?      @relation(fields: [householdId, recipientId], references: [householdId, id], onDelete: Restrict)
  inspections ContentInspection[]

  @@index([householdId, status, expiresAt])
  @@index([requestedByUserId, createdAt])
  @@map("inspection_grants")
}

model ContentInspection {
  id               String   @id @db.Char(26)
  grantId          String   @map("grant_id") @db.Char(26)
  operatorUserId   String   @map("operator_user_id") @db.Char(26)
  resourceType     String   @map("resource_type") @db.VarChar(64)
  resourceId       String   @map("resource_id") @db.Char(26)
  originalRevealed Boolean  @default(false) @map("original_revealed")
  requestId        String   @map("request_id") @db.VarChar(64)
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.DateTime(3)

  grant    InspectionGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  operator User            @relation("ContentInspectionOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)

  @@index([grantId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@map("content_inspections")
}

model AuditLog {
  id                String    @id @db.Char(26)
  occurredAt        DateTime  @default(now()) @map("occurred_at") @db.DateTime(3)
  environment       String    @db.VarChar(16)
  actorType         String    @map("actor_type") @db.VarChar(16)
  actorUserId       String?   @map("actor_user_id") @db.Char(26)
  actorBindingId    String?   @map("actor_binding_id") @db.Char(26)
  actorSessionId    String?   @map("actor_session_id") @db.Char(26)
  actorRoleSnapshot Json?     @map("actor_role_snapshot")
  sourceIpHash      Bytes?    @map("source_ip_hash") @db.Binary(32)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  action            String    @db.VarChar(100)
  resourceType      String    @map("resource_type") @db.VarChar(64)
  resourceId        String?   @map("resource_id") @db.Char(26)
  householdId       String?   @map("household_id") @db.Char(26)
  recipientId       String?   @map("recipient_id") @db.Char(26)
  targetDeviceId    String?   @map("target_device_id") @db.Char(26)
  requestId         String    @map("request_id") @db.VarChar(64)
  traceId           String?   @map("trace_id") @db.VarChar(64)
  purpose           String?   @db.VarChar(100)
  reasonCode        String?   @map("reason_code") @db.VarChar(64)
  ticketId          String?   @map("ticket_id") @db.Char(26)
  approvalActorId   String?   @map("approval_actor_id") @db.Char(26)
  decision          String    @db.VarChar(16)
  failureCode       String?   @map("failure_code") @db.VarChar(64)
  policyVersion     String?   @map("policy_version") @db.VarChar(32)
  changedFieldNames Json?     @map("changed_field_names")
  beforeHash        Bytes?    @map("before_hash") @db.Binary(32)
  afterHash         Bytes?    @map("after_hash") @db.Binary(32)
  previousEventHash Bytes?    @map("previous_event_hash") @db.Binary(32)
  eventHash         Bytes     @map("event_hash") @db.Binary(32)
  retentionUntil    DateTime? @map("retention_until") @db.DateTime(3)

  @@index([householdId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([ticketId, occurredAt])
  @@map("audit_logs")
}

model NotificationEndpoint {
  id                 String    @id @db.Char(26)
  userId             String?   @map("user_id") @db.Char(26)
  deviceId           String?   @map("device_id") @db.Char(26)
  channel            String    @db.VarChar(16)
  provider           String    @db.VarChar(32)
  endpointCiphertext Bytes     @map("endpoint_ciphertext") @db.Blob
  endpointHash       Bytes     @map("endpoint_hash") @db.Binary(32)
  verifiedAt         DateTime? @map("verified_at") @db.DateTime(3)
  status             String    @db.VarChar(32)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user       User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([channel, endpointHash])
  @@index([userId, status])
  @@map("notification_endpoints")
}

model Notification {
  id                    String   @id @db.Char(26)
  householdId           String   @map("household_id") @db.Char(26)
  recipientId           String?  @map("recipient_id") @db.Char(26)
  type                  String   @db.VarChar(64)
  priority              String   @db.VarChar(16)
  templateCode          String   @map("template_code") @db.VarChar(100)
  templateVariablesJson Json     @map("template_variables_json")
  scheduledAt           DateTime @map("scheduled_at") @db.DateTime(3)
  dedupeKey             String   @map("dedupe_key") @db.VarChar(128)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)

  household         Household              @relation(fields: [householdId], references: [id], onDelete: Restrict)
  recipient         CareRecipient?         @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  deliveries        NotificationDelivery[]
  userNotifications UserNotification[]

  @@unique([householdId, dedupeKey])
  @@index([scheduledAt])
  @@map("notifications")
}

model UserNotification {
  notificationId String    @map("notification_id") @db.Char(26)
  userId         String    @map("user_id") @db.Char(26)
  readAt         DateTime? @map("read_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt, createdAt])
  @@map("user_notifications")
}

model NotificationDelivery {
  id                String    @id @db.Char(26)
  notificationId    String    @map("notification_id") @db.Char(26)
  endpointId        String    @map("endpoint_id") @db.Char(26)
  status            String    @db.VarChar(32)
  attemptCount      Int       @default(0) @map("attempt_count")
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.DateTime(3)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(200)
  sentAt            DateTime? @map("sent_at") @db.DateTime(3)
  deliveredAt       DateTime? @map("delivered_at") @db.DateTime(3)
  lastErrorCode     String?   @map("last_error_code") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  notification Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  endpoint     NotificationEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)

  @@unique([notificationId, endpointId])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

model OutboxEvent {
  id            String    @id @db.Char(26)
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.Char(26)
  eventType     String    @map("event_type") @db.VarChar(100)
  payloadJson   Json      @map("payload_json")
  headersJson   Json?     @map("headers_json")
  occurredAt    DateTime  @map("occurred_at") @db.DateTime(3)
  availableAt   DateTime  @map("available_at") @db.DateTime(3)
  leaseOwner    String?   @map("lease_owner") @db.VarChar(100)
  leaseUntil    DateTime? @map("lease_until") @db.DateTime(3)
  publishedAt   DateTime? @map("published_at") @db.DateTime(3)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error") @db.VarChar(1000)

  receipts InboxReceipt[]

  @@index([publishedAt, availableAt])
  @@index([leaseUntil])
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("outbox_events")
}

model InboxReceipt {
  consumer    String   @db.VarChar(100)
  eventId     String   @map("event_id") @db.Char(26)
  processedAt DateTime @default(now()) @map("processed_at") @db.DateTime(3)

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([consumer, eventId])
  @@map("inbox_receipts")
}
