// Implementation schema generated from docs/refactor/database/schema.prisma.
// Application fields are camelCase; @map/@@map preserve the snake_case MySQL contract.
// IDs are application-generated ULIDs. Extensible state values remain VARCHAR rather
// than MySQL ENUMs so adding a state does not require an enum table rewrite.

generator client {
  provider            = "prisma-client"
  output              = "../src/infrastructure/database/generated/prisma"
  engineType          = "client"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

model User {
  id          String    @id @db.Char(26)
  displayName String    @map("display_name") @db.VarChar(100)
  status      String    @db.VarChar(32)
  locale      String    @default("zh-CN") @db.VarChar(16)
  timezone    String    @default("Asia/Shanghai") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)
  version     Int       @default(0)

  loginIdentities            LoginIdentity[]
  passwordCredential         PasswordCredential?
  sessions                   UserSession[]
  oneTimeTokens              OneTimeToken[]
  platformRoleAssignments    PlatformRoleAssignment[] @relation("PlatformRoleSubject")
  assignedPlatformRoles      PlatformRoleAssignment[] @relation("PlatformRoleAssigner")
  householdMemberships       HouseholdMember[]
  createdHouseholds          Household[]              @relation("HouseholdCreator")
  linkedCareRecipients       CareRecipient[]          @relation("CareRecipientLinkedUser")
  requestedInspectionGrants  InspectionGrant[]        @relation("InspectionGrantRequester")
  approvedInspectionGrants   InspectionGrant[]        @relation("InspectionGrantApprover")
  operatedContentInspections ContentInspection[]      @relation("ContentInspectionOperator")
  notificationEndpoints      NotificationEndpoint[]
  userNotifications          UserNotification[]

  @@index([status, createdAt])
  @@map("users")
}

model LoginIdentity {
  id              String    @id @db.Char(26)
  userId          String    @map("user_id") @db.Char(26)
  type            String    @db.VarChar(16)
  value           String    @db.VarChar(320)
  normalizedValue String    @map("normalized_value") @db.VarChar(320)
  verifiedAt      DateTime? @map("verified_at") @db.DateTime(3)
  isPrimary       Boolean   @default(false) @map("is_primary")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, normalizedValue])
  @@index([userId])
  @@map("login_identities")
}

model PasswordCredential {
  userId        String   @id @map("user_id") @db.Char(26)
  passwordHash  Bytes    @map("password_hash") @db.VarBinary(255)
  algorithm     String   @db.VarChar(32)
  paramsVersion Int      @default(1) @map("params_version")
  changedAt     DateTime @map("changed_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model UserSession {
  id                  String    @id @db.Char(26)
  userId              String    @map("user_id") @db.Char(26)
  deviceId            String?   @map("device_id") @db.Char(26)
  refreshTokenHash    Bytes     @unique @map("refresh_token_hash") @db.Binary(32)
  tokenFamilyId       String    @map("token_family_id") @db.Char(26)
  clientType          String    @map("client_type") @db.VarChar(16)
  issuedAt            DateTime  @map("issued_at") @db.DateTime(3)
  expiresAt           DateTime  @map("expires_at") @db.DateTime(3)
  lastUsedAt          DateTime? @map("last_used_at") @db.DateTime(3)
  rotatedAt           DateTime? @map("rotated_at") @db.DateTime(3)
  revokedAt           DateTime? @map("revoked_at") @db.DateTime(3)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Char(26)
  ipHash              Bytes?    @map("ip_hash") @db.Binary(32)
  userAgent           String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamilyId])
  @@map("user_sessions")
}

model OneTimeToken {
  id           String    @id @db.Char(26)
  userId       String    @map("user_id") @db.Char(26)
  identityId   String?   @map("identity_id") @db.Char(26)
  purpose      String    @db.VarChar(32)
  tokenHash    Bytes     @unique @map("token_hash") @db.Binary(32)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  consumedAt   DateTime? @map("consumed_at") @db.DateTime(3)
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("one_time_tokens")
}

model Role {
  id          String   @id @db.Char(26)
  scope       String   @db.VarChar(16)
  code        String   @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  rolePermissions      RolePermission[]
  platformAssignments  PlatformRoleAssignment[]
  householdMemberRoles HouseholdMemberRole[]
  householdInvitations HouseholdInvitation[]

  @@unique([scope, code])
  @@map("roles")
}

model Permission {
  id          String   @id @db.Char(26)
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(26)
  permissionId String @map("permission_id") @db.Char(26)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PlatformRoleAssignment {
  userId       String   @map("user_id") @db.Char(26)
  roleId       String   @map("role_id") @db.Char(26)
  assignedById String?  @map("assigned_by_id") @db.Char(26)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  user       User  @relation("PlatformRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("PlatformRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("platform_role_assignments")
}

model Household {
  id              String   @id @db.Char(26)
  name            String   @db.VarChar(100)
  timezone        String   @default("Asia/Shanghai") @db.VarChar(64)
  status          String   @db.VarChar(32)
  createdByUserId String   @map("created_by_user_id") @db.Char(26)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version         Int      @default(0)

  createdBy            User                        @relation("HouseholdCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members              HouseholdMember[]
  invitations          HouseholdInvitation[]
  careRecipients       CareRecipient[]
  companionBindings    CompanionBinding[]
  activationChallenges DeviceActivationChallenge[]
  consentStates        RecipientConsentState[]
  consentEvents        RecipientConsentEvent[]
  memories             Memory[]
  assets               Asset[]
  medications          Medication[]
  routines             Routine[]
  occurrences          RoutineOccurrence[]
  careEvents           CareEvent[]
  familyTasks          FamilyTask[]
  companionSessions    CompanionSession[]
  remoteSessions       RemoteAssistanceSession[]
  notifications        Notification[]
  inspectionGrants     InspectionGrant[]

  @@index([status, createdAt])
  @@map("households")
}

model HouseholdMember {
  id                String    @id @db.Char(26)
  householdId       String    @map("household_id") @db.Char(26)
  userId            String    @map("user_id") @db.Char(26)
  status            String    @db.VarChar(32)
  invitedByMemberId String?   @map("invited_by_member_id") @db.Char(26)
  joinedAt          DateTime? @map("joined_at") @db.DateTime(3)
  leftAt            DateTime? @map("left_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  version           Int       @default(0)

  household                    Household                   @relation(fields: [householdId], references: [id], onDelete: Restrict)
  user                         User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedByMember              HouseholdMember?            @relation("HouseholdMemberInviter", fields: [invitedByMemberId], references: [id], onDelete: SetNull)
  invitedMembers               HouseholdMember[]           @relation("HouseholdMemberInviter")
  roles                        HouseholdMemberRole[]
  recipientMembers             RecipientMember[]
  trustedContacts              TrustedContact[]
  issuedInvitations            HouseholdInvitation[]
  activatedBindings            CompanionBinding[]
  issuedActivationChallenges   DeviceActivationChallenge[] @relation("ActivationChallengeIssuer")
  approvedActivationChallenges DeviceActivationChallenge[] @relation("ActivationChallengeApprover")
  consentDecisions             RecipientConsentEvent[]
  policyMemberships            RemoteAccessPolicyMember[]

  @@unique([householdId, userId])
  @@unique([householdId, id])
  @@index([userId, status])
  @@map("household_members")
}

model HouseholdMemberRole {
  memberId String @map("member_id") @db.Char(26)
  roleId   String @map("role_id") @db.Char(26)

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([memberId, roleId])
  @@map("household_member_roles")
}

model HouseholdInvitation {
  id                    String    @id @db.Char(26)
  householdId           String    @map("household_id") @db.Char(26)
  targetEmailNormalized String    @map("target_email_normalized") @db.VarChar(320)
  roleId                String    @map("role_id") @db.Char(26)
  tokenHash             Bytes     @unique @map("token_hash") @db.Binary(32)
  issuedByMemberId      String    @map("issued_by_member_id") @db.Char(26)
  expiresAt             DateTime  @map("expires_at") @db.DateTime(3)
  acceptedAt            DateTime? @map("accepted_at") @db.DateTime(3)
  revokedAt             DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  household Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  role      Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  issuer    HouseholdMember @relation(fields: [householdId, issuedByMemberId], references: [householdId, id], onDelete: Restrict)

  @@index([householdId, expiresAt])
  @@map("household_invitations")
}

model CareRecipient {
  id                           String    @id @db.Char(26)
  householdId                  String    @map("household_id") @db.Char(26)
  linkedUserId                 String?   @map("linked_user_id") @db.Char(26)
  name                         String    @db.VarChar(100)
  preferredName                String    @map("preferred_name") @db.VarChar(100)
  birthDate                    DateTime? @map("birth_date") @db.Date
  timezone                     String    @default("Asia/Shanghai") @db.VarChar(64)
  homeLabel                    String?   @map("home_label") @db.VarChar(100)
  communicationNotesCiphertext Bytes?    @map("communication_notes_ciphertext") @db.LongBlob
  communicationNotesNonce      Bytes?    @map("communication_notes_nonce") @db.VarBinary(24)
  encryptionKeyId              String?   @map("encryption_key_id") @db.VarChar(64)
  status                       String    @db.VarChar(32)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt                    DateTime? @map("deleted_at") @db.DateTime(3)
  version                      Int       @default(0)

  household            Household                   @relation(fields: [householdId], references: [id], onDelete: Restrict)
  linkedUser           User?                       @relation("CareRecipientLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  memberAuthorities    RecipientMember[]
  trustedContacts      TrustedContact[]
  bindings             CompanionBinding[]
  activationChallenges DeviceActivationChallenge[]
  consentStates        RecipientConsentState[]
  consentEvents        RecipientConsentEvent[]
  memories             Memory[]
  assets               Asset[]
  assetLinks           RecipientAsset[]
  medications          Medication[]
  routines             Routine[]
  occurrences          RoutineOccurrence[]
  careEvents           CareEvent[]
  familyTasks          FamilyTask[]
  companionSessions    CompanionSession[]
  remoteSessions       RemoteAssistanceSession[]
  notifications        Notification[]
  inspectionGrants     InspectionGrant[]

  @@unique([householdId, id])
  @@index([householdId, status])
  @@map("care_recipients")
}

model RecipientMember {
  id                   String   @id @db.Char(26)
  householdId          String   @map("household_id") @db.Char(26)
  recipientId          String   @map("recipient_id") @db.Char(26)
  householdMemberId    String   @map("household_member_id") @db.Char(26)
  relationshipLabel    String?  @map("relationship_label") @db.VarChar(50)
  accessLevel          String   @map("access_level") @db.VarChar(32)
  canManageProfile     Boolean  @default(false) @map("can_manage_profile")
  canManageConsent     Boolean  @default(false) @map("can_manage_consent")
  canManageRoutine     Boolean  @default(false) @map("can_manage_routine")
  canViewEvents        Boolean  @default(false) @map("can_view_events")
  canViewConversation  Boolean  @default(false) @map("can_view_conversation")
  canActivateDevice    Boolean  @default(false) @map("can_activate_device")
  canRemoteCall        Boolean  @default(false) @map("can_remote_call")
  receiveNotifications Boolean  @default(true) @map("receive_notifications")
  contactPriority      Int?     @map("contact_priority")
  status               String   @db.VarChar(32)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version              Int      @default(0)

  recipient CareRecipient   @relation(fields: [householdId, recipientId], references: [householdId, id], onDelete: Cascade)
  member    HouseholdMember @relation(fields: [householdId, householdMemberId], references: [householdId, id], onDelete: Cascade)

  @@unique([recipientId, householdMemberId])
  @@index([householdId, status])
  @@map("recipient_members")
}

model TrustedContact {
  id                String   @id @db.Char(26)
  householdId       String   @map("household_id") @db.Char(26)
  recipientId       String   @map("recipient_id") @db.Char(26)
  householdMemberId String?  @map("household_member_id") @db.Char(26)
  name              String   @db.VarChar(100)
  relationshipLabel String   @map("relationship_label") @db.VarChar(50)
  phoneCiphertext   Bytes?   @map("phone_ciphertext") @db.Blob
  emailCiphertext   Bytes?   @map("email_ciphertext") @db.Blob
  contactNonce      Bytes?   @map("contact_nonce") @db.VarBinary(24)
  encryptionKeyId   String?  @map("encryption_key_id") @db.VarChar(64)
  priority          Int      @default(1)
  canViewEvidence   Boolean  @default(false) @map("can_view_evidence")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version           Int      @default(0)

  recipient CareRecipient    @relation(fields: [householdId, recipientId], references: [householdId, id], onDelete: Cascade)
  member    HouseholdMember? @relation(fields: [householdId, householdMemberId], references: [householdId, id], onDelete: Restrict)

  @@index([recipientId, priority])
  @@map("trusted_contacts")
}

model Device {
  id                         String    @id @db.Char(26)
  platform                   String    @db.VarChar(16)
  installationKeyFingerprint Bytes     @unique @map("installation_key_fingerprint") @db.Binary(32)
  installationPublicKey      Bytes     @map("installation_public_key") @db.Blob
  manufacturer               String?   @db.VarChar(100)
  model                      String?   @db.VarChar(100)
  osVersion                  String?   @map("os_version") @db.VarChar(64)
  appVersion                 String?   @map("app_version") @db.VarChar(32)
  lastSeenAt                 DateTime? @map("last_seen_at") @db.DateTime(3)
  status                     String    @db.VarChar(32)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  version                    Int       @default(0)

  companionBinding CompanionBinding?
  challenges       DeviceActivationChallenge[]

  @@index([status, lastSeenAt])
  @@map("devices")
}

model CompanionBinding {
  id                  String    @id @db.Char(26)
  deviceId            String    @unique @map("device_id") @db.Char(26)
  householdId         String    @map("household_id") @db.Char(26)
  recipientId         String    @map("recipient_id") @db.Char(26)
  displayName         String    @map("display_name") @db.VarChar(100)
  status              String    @db.VarChar(32)
  activatedByMemberId String    @map("activated_by_member_id") @db.Char(26)
  activatedAt         DateTime  @map("activated_at") @db.DateTime(3)
  revokedAt           DateTime? @map("revoked_at") @db.DateTime(3)
  bindingVersion      Int       @default(1) @map("binding_version")
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  version             Int       @default(0)

  device             Device                    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  household          Household                 @relation(fields: [householdId], references: [id], onDelete: Restrict)
  recipient          CareRecipient             @relation(fields: [householdId, recipientId], references: [householdId, id], onDelete: Restrict)
  activatedBy        HouseholdMember           @relation(fields: [householdId, activatedByMemberId], references: [householdId, id], onDelete: Restrict)
  credentials        DeviceCredential[]
  events             DeviceBindingEvent[]
  companionSessions  CompanionSession[]
  remoteAccessPolicy RemoteAccessPolicy?
  remoteSessions     RemoteAssistanceSession[]

  @@index([householdId, recipientId, status])
  @@map("companion_bindings")
}

model DeviceBindingEvent {
  id         String   @id @db.Char(26)
  bindingId  String   @map("binding_id") @db.Char(26)
  eventType  String   @map("event_type") @db.VarChar(32)
  actorType  String   @map("actor_type") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.Char(26)
  reasonCode String?  @map("reason_code") @db.VarChar(64)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.DateTime(3)

  binding CompanionBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)

  @@index([bindingId, occurredAt])
  @@map("device_binding_events")
}

model DeviceActivationChallenge {
  id                 String    @id @db.Char(26)
  publicId           String    @unique @map("public_id") @db.VarChar(32)
  flow               String    @db.VarChar(32)
  householdId        String    @map("household_id") @db.Char(26)
  recipientId        String    @map("recipient_id") @db.Char(26)
  pendingDeviceId    String?   @map("pending_device_id") @db.Char(26)
  secretHash         Bytes     @unique @map("secret_hash") @db.Binary(32)
  codeHash           Bytes?    @map("code_hash") @db.Binary(32)
  status             String    @db.VarChar(32)
  issuedByMemberId   String    @map("issued_by_member_id") @db.Char(26)
  approvedByMemberId String?   @map("approved_by_member_id") @db.Char(26)
  expiresAt          DateTime  @map("expires_at") @db.DateTime(3)
  claimedAt          DateTime? @map("claimed_at") @db.DateTime(3)
  approvedAt         DateTime? @map("approved_at") @db.DateTime(3)
  consumedAt         DateTime? @map("consumed_at") @db.DateTime(3)
  attemptCount       Int       @default(0) @map("attempt_count")
  maxAttempts        Int       @default(5) @map("max_attempts")
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  version            Int       @default(0)

  household        Household        @relation(fields: [householdId], references: [id], onDelete: Restrict)
  recipient        CareRecipient    @relation(fields: [householdId, recipientId], references: [householdId, id], onDelete: Restrict)
  pendingDevice    Device?          @relation(fields: [pendingDeviceId], references: [id], onDelete: SetNull)
  issuedByMember   HouseholdMember  @relation("ActivationChallengeIssuer", fields: [householdId, issuedByMemberId], references: [householdId, id], onDelete: Restrict)
  approvedByMember HouseholdMember? @relation("ActivationChallengeApprover", fields: [householdId, approvedByMemberId], references: [householdId, id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([householdId, recipientId, status])
  @@map("device_activation_challenges")
}

model DeviceCredential {
  id                  String    @id @db.Char(26)
  bindingId           String    @map("binding_id") @db.Char(26)
  credentialHash      Bytes     @unique @map("credential_hash") @db.Binary(32)
  credentialFamilyId  String    @map("credential_family_id") @db.Char(26)
  deviceKeyThumbprint Bytes     @map("device_key_thumbprint") @db.Binary(32)
  issuedAt            DateTime  @map("issued_at") @db.DateTime(3)
  expiresAt           DateTime  @map("expires_at") @db.DateTime(3)
  lastUsedAt          DateTime? @map("last_used_at") @db.DateTime(3)
  rotatedAt           DateTime? @map("rotated_at") @db.DateTime(3)
  revokedAt           DateTime? @map("revoked_at") @db.DateTime(3)

  binding CompanionBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId, revokedAt, expiresAt])
  @@index([credentialFamilyId])
  @@map("device_credentials")
}

model ConsentDocumentVersion {
  id          String   @id @db.Char(26)
  code        String   @db.VarChar(64)
  version     Int
  contentHash Bytes    @map("content_hash") @db.Binary(32)
  publishedAt DateTime @map("published_at") @db.DateTime(3)

  events RecipientConsentEvent[]

  @@unique([code, version])
  @@map("consent_document_versions")
}

model RecipientConsentState {
  id          String   @id @db.Char(26)
  householdId String   @map("household_id") @db.Char(26)
  recipientId String   @map("recipient_id") @db.Char(26)
  scope       String   @db.VarChar(64)
  decision    String   @db.VarChar(16)
  lastEventId String?  @unique @map("last_event_id") @db.Char(26)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version     Int      @default(0)

  household Household              @relation(fields: [householdId], references: [id], onDelete: Restrict)
  recipient CareRecipient          @relation(fields: [householdId, recipientId], references: [householdId, id], onDelete: Restrict)
  lastEvent RecipientConsentEvent? @relation("CurrentConsentEvent", fields: [lastEventId], references: [id], onDelete: SetNull)

  @@unique([recipientId, scope])
  @@index([householdId, scope, decision])
  @@map("recipient_consent_states")
}

model RecipientConsentEvent {
  id                String   @id @db.Char(26)
  householdId       String   @map("household_id") @db.Char(26)
  recipientId       String   @map("recipient_id") @db.Char(26)
  scope             String   @db.VarChar(64)
  decision          String   @db.VarChar(16)
  documentVersionId String   @map("document_version_id") @db.Char(26)
  decidedByMemberId String   @map("decided_by_member_id") @db.Char(26)
  reason            String?  @db.VarChar(500)
  supersedesEventId String?  @map("supersedes_event_id") @db.Char(26)
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.DateTime(3)

  household          Household               @relation(fields: [householdId], references: [id], onDelete: Restrict)
  recipient          CareRecipient           @relation(fields: [householdId, recipientId], references: [householdId, id], onDelete: Restrict)
