# Same-origin deployment uses /openBMB/api/v1 by default.
# VITE_API_BASE=http://127.0.0.1:3000/openBMB/api/v1
ADMIN_API_PROXY_TARGET=http://127.0.0.1:3000

# Production must keep both values as shown. The server independently hard-disables inspection.
VITE_DEPLOYMENT_ENVIRONMENT=production
VITE_ENABLE_DEVELOPMENT_CONTENT_INSPECTION=false
