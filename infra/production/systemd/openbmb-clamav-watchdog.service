[Unit]
Description=Verify and recover the OpenBMB ClamAV scanner
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/openbmb/current
ConditionPathExists=/etc/openbmb/infra.env
ConditionPathExists=/etc/openbmb/api.env

[Service]
Type=oneshot
Environment=OPENBMB_INFRA_ENV_FILE=/etc/openbmb/infra.env
Environment=DOCKER_CONFIG=/tmp/openbmb-watchdog-docker-config
ExecStart=/bin/bash /opt/openbmb/current/infra/production/scripts/clamav-watchdog.sh
User=root
Group=root
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=openbmb
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/lock /run/openbmb
NoNewPrivileges=true
SuccessExitStatus=75
TimeoutStartSec=3600
TimeoutStopSec=120
