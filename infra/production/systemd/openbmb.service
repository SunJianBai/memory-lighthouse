[Unit]
Description=OpenBMB Memory Lighthouse production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/openbmb/current
ConditionPathIsSymbolicLink=/opt/openbmb/current-app
ConditionPathExists=/etc/openbmb/infra.env
ConditionPathExists=/etc/openbmb/api.env

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=OPENBMB_INFRA_ENV_FILE=/etc/openbmb/infra.env
ExecStart=/bin/bash /opt/openbmb/current/infra/production/scripts/service-control.sh start
ExecReload=/bin/bash /opt/openbmb/current/infra/production/scripts/service-control.sh reload
ExecStop=/bin/bash /opt/openbmb/current/infra/production/scripts/service-control.sh stop
# A rebuilt ClamAV signature volume can take 30 minutes, followed by a bounded
# FreshClam process/freshness check.
TimeoutStartSec=3600
TimeoutStopSec=120
UMask=0027

[Install]
WantedBy=multi-user.target
