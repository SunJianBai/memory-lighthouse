[Unit]
Description=Create an OpenBMB MySQL and MinIO backup
Requires=docker.service
After=docker.service openbmb.service
ConditionPathIsSymbolicLink=/opt/openbmb/current
ConditionPathIsSymbolicLink=/opt/openbmb/current-app

[Service]
Type=oneshot
Environment=OPENBMB_INFRA_ENV_FILE=/etc/openbmb/infra.env
Environment=DOCKER_CONFIG=/tmp/openbmb-backup-docker-config
Environment=OPENBMB_BACKUP_ROOT=/var/backups/openbmb
ExecStart=/bin/bash /opt/openbmb/current/infra/production/scripts/backup.sh
ExecStopPost=/bin/bash /opt/openbmb/current/infra/production/scripts/service-control.sh reload
User=root
Group=root
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=openbmb
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/backups/openbmb /run/lock /run/openbmb
NoNewPrivileges=true
TimeoutStartSec=3600
TimeoutStopSec=3600
