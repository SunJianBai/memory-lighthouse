# Install as /etc/openbmb/infra.env with owner root:openbmb and mode 0640.
# Every CHANGE_ME value must be replaced. Infrastructure secrets are limited to
# base64url characters so they remain safe inside interpolated URLs.

TZ=Asia/Shanghai
OPENBMB_DOMAIN=sun227454.online
OPENBMB_API_ENV_FILE=/etc/openbmb/api.env

# Exact image tags are intentional. Review release notes before upgrading.
MYSQL_IMAGE=mysql:8.4.8
REDIS_IMAGE=redis:7.4.10-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-08T15-39-49Z
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.4

MYSQL_DATABASE=openbmb
MYSQL_USER=openbmb
MYSQL_PASSWORD=CHANGE_ME_BASE64URL_48_CHARS
MYSQL_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
MYSQL_HOST_PORT=13306

REDIS_APP_PASSWORD=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
REDIS_LIVEKIT_PASSWORD=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
REDIS_HOST_PORT=16379
REDIS_LIVEKIT_HOST_PORT=16380

MINIO_ROOT_USER=openbmb-root
MINIO_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
MINIO_APP_ACCESS_KEY=openbmb-api
MINIO_APP_SECRET_KEY=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
MINIO_BUCKET=openbmb-assets
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
MINIO_SERVER_URL=https://sun227454.online
MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:19001
OBJECT_STORAGE_REGION=us-east-1

# The webhook configuration fixes this public identifier to openbmb_api.
LIVEKIT_API_KEY=openbmb_api
LIVEKIT_API_SECRET=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
LIVEKIT_NODE_IP=124.220.81.104
LIVEKIT_SIGNAL_HOST_PORT=17880
LIVEKIT_ICE_TCP_PORT=7881
LIVEKIT_ICE_UDP_PORT=7882
LIVEKIT_TURN_UDP_PORT=3478

OPENBMB_CLIENT_HOST_PORT=14173
OPENBMB_ADMIN_HOST_PORT=14174
