# Install as /etc/openbmb/api.env with owner root:root and mode 0600.
# The native API reads a separately rendered, least-privilege native-api.env.
# Compose injects database, Redis, MinIO and LiveKit credentials separately;
# never duplicate infrastructure root credentials in this file.

# QQ SMTP is mandatory in production and is verified before readiness succeeds.
# Enable SMTP in QQ Mail first. Use the generated authorization code here, not
# the QQ account password; keep the real address and authorization code only in
# /etc/openbmb/api.env.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=CHANGE_ME_QQ_EMAIL_ADDRESS
SMTP_PASSWORD=CHANGE_ME_QQ_SMTP_AUTHORIZATION_CODE
SMTP_FROM_NAME=守忆灯塔
SMTP_FROM_ADDRESS=CHANGE_ME_QQ_EMAIL_ADDRESS
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Generate each value independently. Base64url values should decode to at
# least 32 random bytes; the DATA key is exactly 32 bytes in standard Base64.
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_BASE64URL_48_CHARS
AUTH_ADMIN_ACCESS_TOKEN_SECRET=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
AUTH_REFRESH_TOKEN_PEPPER=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
AUTH_ONE_TIME_TOKEN_PEPPER=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
HOUSEHOLD_INVITATION_TOKEN_PEPPER=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
# Also used through a separate HMAC domain for non-reversible audit IP pseudonyms.
RATE_LIMIT_KEY_SECRET=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
DEVICE_ACTIVATION_PEPPER=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
DEVICE_CREDENTIAL_PEPPER=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
DEVICE_ACCESS_TOKEN_SECRET=CHANGE_ME_DIFFERENT_BASE64URL_48_CHARS
DATA_ENCRYPTION_KEY_BASE64=CHANGE_ME_EXACTLY_32_RANDOM_BYTES_STANDARD_BASE64
DATA_ENCRYPTION_KEY_ID=production-key-1
CARE_WORKFLOW_ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_RANDOM_BYTES_BASE64URL

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_ADMIN_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=600
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
HOUSEHOLD_INVITATION_TTL_SECONDS=604800
DEVICE_ACCESS_TOKEN_TTL_SECONDS=600
DEVICE_ACTIVATION_CHALLENGE_TTL_SECONDS=300
DEVICE_ACTIVATION_MAX_ATTEMPTS=5
DEVICE_CREDENTIAL_TTL_SECONDS=2592000
RATE_LIMIT_REDIS_PREFIX=openbmb:rate-limit:v1
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=5000

CARE_WORKFLOW_SCHEDULER_ENABLED=true
CARE_WORKFLOW_SCHEDULER_INTERVAL_MS=60000
CARE_WORKFLOW_GENERATION_HORIZON_HOURS=24
TRANSCRIPT_RETENTION_DAYS=30
TRANSCRIPT_PURGE_ENABLED=true
TRANSCRIPT_PURGE_INTERVAL_MS=300000
TRANSCRIPT_PURGE_BATCH_SIZE=100

ASSET_LIFECYCLE_WORKER_ENABLED=true
ASSET_LIFECYCLE_INTERVAL_MS=5000
ASSET_LIFECYCLE_CONCURRENCY=1
ASSET_LIFECYCLE_BATCH_SIZE=20
ASSET_LIFECYCLE_RECOVERY_BATCH_SIZE=100
ASSET_LIFECYCLE_LEASE_MS=300000
ASSET_LIFECYCLE_RETRY_BASE_MS=1000
ASSET_LIFECYCLE_RETRY_MAX_MS=300000

# clamd TCP has no transport authentication. Production publishes the scanner
# only on TX4H4G loopback; never open CLAMAV_HOST_PORT in UFW/security groups.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
CLAMAV_SCAN_TIMEOUT_MS=120000

DEVICE_ONLINE_THRESHOLD_SECONDS=120
REMOTE_SESSION_EXPIRY_ENABLED=true
REMOTE_SESSION_EXPIRY_INTERVAL_MS=15000
REMOTE_RING_TIMEOUT_SECONDS=60
REMOTE_CONNECT_TIMEOUT_SECONDS=180

# MiniCPM clients obtain the provider endpoint from the authenticated device
# session. The current official ModelBest Realtime endpoint requires no API
# key. User transcripts are stored only when the provider returns real ASR
# finals and MODEL_INPUT_TRANSCRIPTION consent is granted.
MINICPM_PROVIDER=modelbest
MINICPM_MODEL=openbmb/MiniCPM-o-4_5
MINICPM_REALTIME_URL=wss://minicpmo45.modelbest.cn/v1/realtime
# Optional single-line, audited bootstrap template. Leave empty to publish the
# versioned built-in prompt; never paste household or session data here.
MINICPM_SYSTEM_PROMPT=

# Optional live weather injected into each new companion model session. Set a
# coarse city/district query, or set both coordinates plus a display name. A
# query is sent to Open-Meteo for geocoding; never configure a precise address.
WEATHER_LOCATION_QUERY=
WEATHER_LOCATION_LATITUDE=
WEATHER_LOCATION_LONGITUDE=
WEATHER_LOCATION_NAME=
WEATHER_REQUEST_TIMEOUT_MS=2500
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_STALE_TTL_SECONDS=1800

# This is also forced false by Compose and cannot be enabled in production.
ENABLE_DEVELOPMENT_CONTENT_INSPECTION=false
