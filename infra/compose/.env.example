# Copy to `.env`, generate every blank secret independently, and never commit it.
# Secrets should use only base64url characters (A-Z, a-z, 0-9, _ and -).

TZ=Asia/Shanghai

# Exact tags are deliberate. Review release notes before changing them.
MYSQL_IMAGE=mysql:8.4.8
REDIS_IMAGE=redis:7.4.10-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-08T15-39-49Z
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.4

MYSQL_DATABASE=openbmb
MYSQL_USER=openbmb
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=13306

# Redis ACL users are fixed as `openbmb-api` and `livekit`.
REDIS_APP_PASSWORD=
REDIS_LIVEKIT_PASSWORD=
REDIS_HOST_PORT=16379

MINIO_ROOT_USER=openbmb-root
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=openbmb-api
MINIO_APP_SECRET_KEY=
MINIO_BUCKET=openbmb-assets
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
MINIO_SERVER_URL=http://127.0.0.1:19000
MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:19001

LIVEKIT_API_KEY=openbmb_api
LIVEKIT_API_SECRET=

# Local development defaults. For TX4H4G use 124.220.81.104 and 0.0.0.0.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_MEDIA_BIND_IP=127.0.0.1
LIVEKIT_SIGNAL_HOST_PORT=17880
LIVEKIT_ICE_TCP_PORT=7881
LIVEKIT_ICE_UDP_PORT=7882
LIVEKIT_TURN_UDP_PORT=3478

# Values consumed by the applications, shown here to keep endpoint naming aligned.
DATABASE_URL=mysql://openbmb:REPLACE_WITH_MYSQL_PASSWORD@127.0.0.1:13306/openbmb
REDIS_URL=redis://openbmb-api:REPLACE_WITH_REDIS_APP_PASSWORD@127.0.0.1:16379/0
S3_ENDPOINT=http://127.0.0.1:19000
LIVEKIT_URL=ws://127.0.0.1:17880
