// Target data-model draft for the refactored server.
// IDs are application-generated ULIDs. Status columns intentionally remain strings
// so state additions do not require MySQL ENUM rewrites.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

model User {
  id           String    @id @db.Char(26)
  display_name String    @db.VarChar(100)
  status       String    @db.VarChar(32)
  locale       String    @default("zh-CN") @db.VarChar(16)
  timezone     String    @default("Asia/Shanghai") @db.VarChar(64)
  created_at   DateTime  @default(now()) @db.DateTime(3)
  updated_at   DateTime  @updatedAt @db.DateTime(3)
  deleted_at   DateTime? @db.DateTime(3)
  version      Int       @default(0)

  login_identities          LoginIdentity[]
  password_credential       PasswordCredential?
  sessions                  UserSession[]
  one_time_tokens           OneTimeToken[]
  platform_role_assignments PlatformRoleAssignment[]
  household_memberships     HouseholdMember[]
  notification_endpoints    NotificationEndpoint[]

  @@index([status, created_at])
  @@map("users")
}

model LoginIdentity {
  id               String    @id @db.Char(26)
  user_id          String    @db.Char(26)
  type             String    @db.VarChar(16)
  value            String    @db.VarChar(320)
  normalized_value String    @db.VarChar(320)
  verified_at      DateTime? @db.DateTime(3)
  is_primary       Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.DateTime(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([type, normalized_value])
  @@index([user_id])
  @@map("login_identities")
}

model PasswordCredential {
  user_id        String   @id @db.Char(26)
  password_hash  Bytes    @db.VarBinary(255)
  algorithm      String   @db.VarChar(32)
  params_version Int      @default(1)
  changed_at     DateTime @db.DateTime(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model UserSession {
  id                     String    @id @db.Char(26)
  user_id                String    @db.Char(26)
  device_id              String?   @db.Char(26)
  refresh_token_hash     Bytes     @unique @db.Binary(32)
  token_family_id        String    @db.Char(26)
  client_type            String    @db.VarChar(16)
  issued_at              DateTime  @db.DateTime(3)
  expires_at             DateTime  @db.DateTime(3)
  last_used_at           DateTime? @db.DateTime(3)
  rotated_at             DateTime? @db.DateTime(3)
  revoked_at             DateTime? @db.DateTime(3)
  replaced_by_session_id String?   @db.Char(26)
  ip_hash                Bytes?    @db.Binary(32)
  user_agent             String?   @db.VarChar(512)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at, expires_at])
  @@index([token_family_id])
  @@map("user_sessions")
}

model OneTimeToken {
  id            String    @id @db.Char(26)
  user_id       String    @db.Char(26)
  identity_id   String?   @db.Char(26)
  purpose       String    @db.VarChar(32)
  token_hash    Bytes     @unique @db.Binary(32)
  expires_at    DateTime  @db.DateTime(3)
  consumed_at   DateTime? @db.DateTime(3)
  attempt_count Int       @default(0)
  created_at    DateTime  @default(now()) @db.DateTime(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose, expires_at])
  @@map("one_time_tokens")
}

model Role {
  id          String   @id @db.Char(26)
  scope       String   @db.VarChar(16)
  code        String   @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.DateTime(3)

  role_permissions       RolePermission[]
  platform_assignments   PlatformRoleAssignment[]
  household_member_roles HouseholdMemberRole[]

  @@unique([scope, code])
  @@map("roles")
}

model Permission {
  id          String   @id @db.Char(26)
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.DateTime(3)

  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String @db.Char(26)
  permission_id String @db.Char(26)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model PlatformRoleAssignment {
  user_id        String   @db.Char(26)
  role_id        String   @db.Char(26)
  assigned_by_id String?  @db.Char(26)
  assigned_at    DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@id([user_id, role_id])
  @@map("platform_role_assignments")
}

model Household {
  id                 String   @id @db.Char(26)
  name               String   @db.VarChar(100)
  timezone           String   @default("Asia/Shanghai") @db.VarChar(64)
  status             String   @db.VarChar(32)
  created_by_user_id String   @db.Char(26)
  created_at         DateTime @default(now()) @db.DateTime(3)
  updated_at         DateTime @updatedAt @db.DateTime(3)
  version            Int      @default(0)

  members            HouseholdMember[]
  invitations        HouseholdInvitation[]
  care_recipients    CareRecipient[]
  memories           Memory[]
  assets             Asset[]
  medications        Medication[]
  routines           Routine[]
  occurrences        RoutineOccurrence[]
  care_events        CareEvent[]
  family_tasks       FamilyTask[]
  companion_sessions CompanionSession[]
  remote_sessions    RemoteAssistanceSession[]
  notifications      Notification[]
  inspection_grants  InspectionGrant[]

  @@index([status, created_at])
  @@map("households")
}

model HouseholdMember {
  id                   String    @id @db.Char(26)
  household_id         String    @db.Char(26)
  user_id              String    @db.Char(26)
  status               String    @db.VarChar(32)
  invited_by_member_id String?   @db.Char(26)
  joined_at            DateTime? @db.DateTime(3)
  left_at              DateTime? @db.DateTime(3)
  created_at           DateTime  @default(now()) @db.DateTime(3)
  updated_at           DateTime  @updatedAt @db.DateTime(3)
  version              Int       @default(0)

  household          Household                  @relation(fields: [household_id], references: [id], onDelete: Restrict)
  user               User                       @relation(fields: [user_id], references: [id], onDelete: Restrict)
  roles              HouseholdMemberRole[]
  recipient_members  RecipientMember[]
  issued_invitations HouseholdInvitation[]
  policy_memberships RemoteAccessPolicyMember[]

  @@unique([household_id, user_id])
  @@index([user_id, status])
  @@map("household_members")
}

model HouseholdMemberRole {
  member_id String @db.Char(26)
  role_id   String @db.Char(26)

  member HouseholdMember @relation(fields: [member_id], references: [id], onDelete: Cascade)
  role   Role            @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@id([member_id, role_id])
  @@map("household_member_roles")
}

model HouseholdInvitation {
  id                      String    @id @db.Char(26)
  household_id            String    @db.Char(26)
  target_email_normalized String    @db.VarChar(320)
  role_id                 String    @db.Char(26)
  token_hash              Bytes     @unique @db.Binary(32)
  issued_by_member_id     String    @db.Char(26)
  expires_at              DateTime  @db.DateTime(3)
  accepted_at             DateTime? @db.DateTime(3)
  revoked_at              DateTime? @db.DateTime(3)
  created_at              DateTime  @default(now()) @db.DateTime(3)

  household Household       @relation(fields: [household_id], references: [id], onDelete: Restrict)
  issuer    HouseholdMember @relation(fields: [issued_by_member_id], references: [id], onDelete: Restrict)

  @@index([household_id, expires_at])
  @@map("household_invitations")
}

model CareRecipient {
  id                             String    @id @db.Char(26)
  household_id                   String    @db.Char(26)
  linked_user_id                 String?   @db.Char(26)
  name                           String    @db.VarChar(100)
  preferred_name                 String    @db.VarChar(100)
  birth_date                     DateTime? @db.Date
  timezone                       String    @default("Asia/Shanghai") @db.VarChar(64)
  home_label                     String?   @db.VarChar(100)
  communication_notes_ciphertext Bytes?    @db.LongBlob
  communication_notes_nonce      Bytes?    @db.VarBinary(24)
  encryption_key_id              String?   @db.VarChar(64)
  status                         String    @db.VarChar(32)
  created_at                     DateTime  @default(now()) @db.DateTime(3)
  updated_at                     DateTime  @updatedAt @db.DateTime(3)
  deleted_at                     DateTime? @db.DateTime(3)
  version                        Int       @default(0)

  household             Household                   @relation(fields: [household_id], references: [id], onDelete: Restrict)
  member_authorities    RecipientMember[]
  trusted_contacts      TrustedContact[]
  bindings              CompanionBinding[]
  activation_challenges DeviceActivationChallenge[]
  consent_states        RecipientConsentState[]
  consent_events        RecipientConsentEvent[]
  memories              Memory[]
  assets                Asset[]
  asset_links           RecipientAsset[]
  medications           Medication[]
  routines              Routine[]
  occurrences           RoutineOccurrence[]
  care_events           CareEvent[]
  family_tasks          FamilyTask[]
  companion_sessions    CompanionSession[]
  remote_sessions       RemoteAssistanceSession[]
  notifications         Notification[]

  @@index([household_id, status])
  @@map("care_recipients")
}

model RecipientMember {
  id                    String   @id @db.Char(26)
  household_id          String   @db.Char(26)
  recipient_id          String   @db.Char(26)
  household_member_id   String   @db.Char(26)
  relationship_label    String?  @db.VarChar(50)
  access_level          String   @db.VarChar(32)
  can_manage_profile    Boolean  @default(false)
  can_manage_routine    Boolean  @default(false)
  can_view_events       Boolean  @default(false)
  can_view_conversation Boolean  @default(false)
  can_activate_device   Boolean  @default(false)
  can_remote_call       Boolean  @default(false)
  receive_notifications Boolean  @default(true)
  contact_priority      Int?
  status                String   @db.VarChar(32)
  created_at            DateTime @default(now()) @db.DateTime(3)
  updated_at            DateTime @updatedAt @db.DateTime(3)
  version               Int      @default(0)

  recipient CareRecipient   @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  member    HouseholdMember @relation(fields: [household_member_id], references: [id], onDelete: Cascade)

  @@unique([recipient_id, household_member_id])
  @@index([household_id, status])
  @@map("recipient_members")
}

model TrustedContact {
  id                  String   @id @db.Char(26)
  household_id        String   @db.Char(26)
  recipient_id        String   @db.Char(26)
  household_member_id String?  @db.Char(26)
  name                String   @db.VarChar(100)
  relationship_label  String   @db.VarChar(50)
  phone_ciphertext    Bytes?   @db.Blob
  email_ciphertext    Bytes?   @db.Blob
  contact_nonce       Bytes?   @db.VarBinary(24)
  encryption_key_id   String?  @db.VarChar(64)
  priority            Int      @default(1)
  can_view_evidence   Boolean  @default(false)
  created_at          DateTime @default(now()) @db.DateTime(3)
  updated_at          DateTime @updatedAt @db.DateTime(3)
  version             Int      @default(0)

  recipient CareRecipient @relation(fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([recipient_id, priority])
  @@map("trusted_contacts")
}

model Device {
  id                           String    @id @db.Char(26)
  platform                     String    @db.VarChar(16)
  installation_key_fingerprint Bytes     @unique @db.Binary(32)
  installation_public_key      Bytes     @db.Blob
  manufacturer                 String?   @db.VarChar(100)
  model                        String?   @db.VarChar(100)
  os_version                   String?   @db.VarChar(64)
  app_version                  String?   @db.VarChar(32)
  last_seen_at                 DateTime? @db.DateTime(3)
  status                       String    @db.VarChar(32)
  created_at                   DateTime  @default(now()) @db.DateTime(3)
  updated_at                   DateTime  @updatedAt @db.DateTime(3)
  version                      Int       @default(0)

  companion_binding CompanionBinding?
  challenges        DeviceActivationChallenge[]

  @@index([status, last_seen_at])
  @@map("devices")
}

model CompanionBinding {
  id                     String    @id @db.Char(26)
  device_id              String    @unique @db.Char(26)
  household_id           String    @db.Char(26)
  recipient_id           String    @db.Char(26)
  display_name           String    @db.VarChar(100)
  status                 String    @db.VarChar(32)
  activated_by_member_id String    @db.Char(26)
  activated_at           DateTime  @db.DateTime(3)
  revoked_at             DateTime? @db.DateTime(3)
  binding_version        Int       @default(1)
  created_at             DateTime  @default(now()) @db.DateTime(3)
  updated_at             DateTime  @updatedAt @db.DateTime(3)
  version                Int       @default(0)

  device               Device                    @relation(fields: [device_id], references: [id], onDelete: Restrict)
  recipient            CareRecipient             @relation(fields: [recipient_id], references: [id], onDelete: Restrict)
  credentials          DeviceCredential[]
  events               DeviceBindingEvent[]
  companion_sessions   CompanionSession[]
  remote_access_policy RemoteAccessPolicy?
  remote_sessions      RemoteAssistanceSession[]

  @@index([household_id, recipient_id, status])
  @@map("companion_bindings")
}

model DeviceBindingEvent {
  id          String   @id @db.Char(26)
  binding_id  String   @db.Char(26)
  event_type  String   @db.VarChar(32)
  actor_type  String   @db.VarChar(16)
  actor_id    String?  @db.Char(26)
  reason_code String?  @db.VarChar(64)
  occurred_at DateTime @default(now()) @db.DateTime(3)

  binding CompanionBinding @relation(fields: [binding_id], references: [id], onDelete: Restrict)

  @@index([binding_id, occurred_at])
  @@map("device_binding_events")
}

model DeviceActivationChallenge {
  id                    String    @id @db.Char(26)
  public_id             String    @unique @db.VarChar(32)
  flow                  String    @db.VarChar(32)
  household_id          String    @db.Char(26)
  recipient_id          String    @db.Char(26)
  pending_device_id     String?   @db.Char(26)
  secret_hash           Bytes     @unique @db.Binary(32)
  code_hash             Bytes?    @db.Binary(32)
  status                String    @db.VarChar(32)
  issued_by_member_id   String    @db.Char(26)
  approved_by_member_id String?   @db.Char(26)
  expires_at            DateTime  @db.DateTime(3)
  claimed_at            DateTime? @db.DateTime(3)
  approved_at           DateTime? @db.DateTime(3)
  consumed_at           DateTime? @db.DateTime(3)
  attempt_count         Int       @default(0)
  max_attempts          Int       @default(5)
  created_at            DateTime  @default(now()) @db.DateTime(3)
  updated_at            DateTime  @updatedAt @db.DateTime(3)
  version               Int       @default(0)

  recipient      CareRecipient @relation(fields: [recipient_id], references: [id], onDelete: Restrict)
  pending_device Device?       @relation(fields: [pending_device_id], references: [id], onDelete: SetNull)

  @@index([status, expires_at])
  @@index([household_id, recipient_id, status])
  @@map("device_activation_challenges")
}

model DeviceCredential {
  id                    String    @id @db.Char(26)
  binding_id            String    @db.Char(26)
  credential_hash       Bytes     @unique @db.Binary(32)
  credential_family_id  String    @db.Char(26)
  device_key_thumbprint Bytes     @db.Binary(32)
  issued_at             DateTime  @db.DateTime(3)
  expires_at            DateTime  @db.DateTime(3)
  last_used_at          DateTime? @db.DateTime(3)
  rotated_at            DateTime? @db.DateTime(3)
  revoked_at            DateTime? @db.DateTime(3)

  binding CompanionBinding @relation(fields: [binding_id], references: [id], onDelete: Cascade)

  @@index([binding_id, revoked_at, expires_at])
  @@index([credential_family_id])
  @@map("device_credentials")
}

model ConsentDocumentVersion {
  id           String   @id @db.Char(26)
  code         String   @db.VarChar(64)
  version      Int
  content_hash Bytes    @db.Binary(32)
  published_at DateTime @db.DateTime(3)

  events RecipientConsentEvent[]

  @@unique([code, version])
  @@map("consent_document_versions")
}

model RecipientConsentState {
  id            String   @id @db.Char(26)
  household_id  String   @db.Char(26)
  recipient_id  String   @db.Char(26)
  scope         String   @db.VarChar(64)
  decision      String   @db.VarChar(16)
  last_event_id String?  @db.Char(26)
  updated_at    DateTime @updatedAt @db.DateTime(3)
  version       Int      @default(0)

  recipient CareRecipient @relation(fields: [recipient_id], references: [id], onDelete: Restrict)

  @@unique([recipient_id, scope])
  @@index([household_id, scope, decision])
  @@map("recipient_consent_states")
}

model RecipientConsentEvent {
  id                   String   @id @db.Char(26)
  household_id         String   @db.Char(26)
  recipient_id         String   @db.Char(26)
  scope                String   @db.VarChar(64)
  decision             String   @db.VarChar(16)
  document_version_id  String   @db.Char(26)
  decided_by_member_id String   @db.Char(26)
  reason               String?  @db.VarChar(500)
  supersedes_event_id  String?  @db.Char(26)
  occurred_at          DateTime @default(now()) @db.DateTime(3)

  recipient        CareRecipient          @relation(fields: [recipient_id], references: [id], onDelete: Restrict)
  document_version ConsentDocumentVersion @relation(fields: [document_version_id], references: [id], onDelete: Restrict)

  @@index([recipient_id, scope, occurred_at])
  @@map("recipient_consent_events")
}

model Memory {
  id                   String    @id @db.Char(26)
  household_id         String    @db.Char(26)
  recipient_id         String    @db.Char(26)
  kind                 String    @db.VarChar(32)
  title                String    @db.VarChar(200)
  sensitivity          String    @db.VarChar(16)
  verification_status  String    @db.VarChar(32)
  status               String    @db.VarChar(32)
  current_revision_no  Int       @default(1)
  created_by_member_id String    @db.Char(26)
  created_at           DateTime  @default(now()) @db.DateTime(3)
  updated_at           DateTime  @updatedAt @db.DateTime(3)
  deleted_at           DateTime? @db.DateTime(3)
  version              Int       @default(0)

  household Household        @relation(fields: [household_id], references: [id], onDelete: Restrict)
  recipient CareRecipient    @relation(fields: [recipient_id], references: [id], onDelete: Restrict)
  revisions MemoryRevision[]
  tags      MemoryTag[]
  assets    MemoryAsset[]

  @@index([recipient_id, status, updated_at])
  @@index([household_id, kind, status])
  @@map("memories")
}

model MemoryRevision {
  id                   String   @id @db.Char(26)
  memory_id            String   @db.Char(26)
  revision_no          Int
  content_ciphertext   Bytes    @db.LongBlob
  content_nonce        Bytes    @db.VarBinary(24)
  encryption_key_id    String   @db.VarChar(64)
  content_hash         Bytes    @db.Binary(32)
  source               String   @db.VarChar(32)
  change_reason        String?  @db.VarChar(500)
  created_by_member_id String   @db.Char(26)
  created_at           DateTime @default(now()) @db.DateTime(3)

  memory Memory              @relation(fields: [memory_id], references: [id], onDelete: Restrict)
  usages MemoryUsageRecord[]

  @@unique([memory_id, revision_no])
  @@map("memory_revisions")
}

model Tag {
  id              String   @id @db.Char(26)
  household_id    String   @db.Char(26)
  name            String   @db.VarChar(100)
  normalized_name String   @db.VarChar(100)
  created_at      DateTime @default(now()) @db.DateTime(3)

  memories MemoryTag[]

  @@unique([household_id, normalized_name])
  @@map("tags")
}

model MemoryTag {
  memory_id String @db.Char(26)
  tag_id    String @db.Char(26)

  memory Memory @relation(fields: [memory_id], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([memory_id, tag_id])
  @@map("memory_tags")
}

model Asset {
  id                    String    @id @db.Char(26)
  household_id          String    @db.Char(26)
  recipient_id          String?   @db.Char(26)
  bucket                String    @db.VarChar(100)
  object_key            String    @db.VarChar(1024)
  original_name         String    @db.VarChar(255)
  mime_type             String    @db.VarChar(128)
  byte_size             BigInt
  sha256                Bytes     @db.Binary(32)
  kind                  String    @db.VarChar(32)
  scan_status           String    @db.VarChar(32)
  encryption_key_id     String?   @db.VarChar(64)
  retention_until       DateTime? @db.DateTime(3)
  status                String    @db.VarChar(32)
  uploaded_by_member_id String    @db.Char(26)
  created_at            DateTime  @default(now()) @db.DateTime(3)
  updated_at            DateTime  @updatedAt @db.DateTime(3)
  version               Int       @default(0)

  household          Household           @relation(fields: [household_id], references: [id], onDelete: Restrict)
  recipient          CareRecipient?      @relation(fields: [recipient_id], references: [id], onDelete: SetNull)
  memory_links       MemoryAsset[]
  recipient_links    RecipientAsset[]
  medication_links   MedicationAsset[]
  event_links        CareEventAsset[]
  conversation_links ConversationAsset[]

  @@unique([bucket, object_key])
  @@index([household_id, sha256])
  @@index([status, retention_until])
  @@map("assets")
}

model MemoryAsset {
  memory_id String @db.Char(26)
  asset_id  String @db.Char(26)
  position  Int    @default(0)

  memory Memory @relation(fields: [memory_id], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [asset_id], references: [id], onDelete: Restrict)

  @@id([memory_id, asset_id])
  @@map("memory_assets")
}

model RecipientAsset {
  recipient_id String @db.Char(26)
  asset_id     String @db.Char(26)
  kind         String @db.VarChar(32)

  recipient CareRecipient @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  asset     Asset         @relation(fields: [asset_id], references: [id], onDelete: Restrict)

  @@id([recipient_id, asset_id])
  @@map("recipient_assets")
}

model Medication {
  id                      String    @id @db.Char(26)
  household_id            String    @db.Char(26)
  recipient_id            String    @db.Char(26)
  name                    String    @db.VarChar(100)
  alias                   String?   @db.VarChar(100)
  purpose_ciphertext      Bytes?    @db.Blob
  requirements_ciphertext Bytes?    @db.LongBlob
  content_nonce           Bytes?    @db.VarBinary(24)
  encryption_key_id       String?   @db.VarChar(64)
  container_label         String?   @db.VarChar(200)
  container_location      String?   @db.VarChar(200)
  status                  String    @db.VarChar(32)
  created_at              DateTime  @default(now()) @db.DateTime(3)
  updated_at              DateTime  @updatedAt @db.DateTime(3)
  deleted_at              DateTime? @db.DateTime(3)
  version                 Int       @default(0)

  household Household         @relation(fields: [household_id], references: [id], onDelete: Restrict)
  recipient CareRecipient     @relation(fields: [recipient_id], references: [id], onDelete: Restrict)
  assets    MedicationAsset[]
  routines  Routine[]

  @@index([recipient_id, status])
