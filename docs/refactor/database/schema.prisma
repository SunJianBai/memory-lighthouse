  deliveries NotificationDelivery[]

  @@unique([household_id, dedupe_key])
  @@index([scheduled_at])
  @@map("notifications")
}

model NotificationDelivery {
  id                  String    @id @db.Char(26)
  notification_id     String    @db.Char(26)
  endpoint_id         String    @db.Char(26)
  status              String    @db.VarChar(32)
  attempt_count       Int       @default(0)
  next_attempt_at     DateTime? @db.DateTime(3)
  provider_message_id String?   @db.VarChar(200)
  sent_at             DateTime? @db.DateTime(3)
  delivered_at        DateTime? @db.DateTime(3)
  last_error_code     String?   @db.VarChar(64)
  created_at          DateTime  @default(now()) @db.DateTime(3)
  updated_at          DateTime  @updatedAt @db.DateTime(3)

  notification Notification         @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  endpoint     NotificationEndpoint @relation(fields: [endpoint_id], references: [id], onDelete: Restrict)

  @@unique([notification_id, endpoint_id])
  @@index([status, next_attempt_at])
  @@map("notification_deliveries")
}

model OutboxEvent {
  id             String    @id @db.Char(26)
  aggregate_type String    @db.VarChar(64)
  aggregate_id   String    @db.Char(26)
  event_type     String    @db.VarChar(100)
  payload_json   Json
  headers_json   Json?
  occurred_at    DateTime  @db.DateTime(3)
  available_at   DateTime  @db.DateTime(3)
  lease_owner    String?   @db.VarChar(100)
  lease_until    DateTime? @db.DateTime(3)
  published_at   DateTime? @db.DateTime(3)
  attempt_count  Int       @default(0)
  last_error     String?   @db.VarChar(1000)

  receipts InboxReceipt[]

  @@index([published_at, available_at])
  @@index([lease_until])
  @@index([aggregate_type, aggregate_id, occurred_at])
  @@map("outbox_events")
}

model InboxReceipt {
  consumer     String   @db.VarChar(100)
  event_id     String   @db.Char(26)
  processed_at DateTime @default(now()) @db.DateTime(3)

  event OutboxEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@id([consumer, event_id])
  @@map("inbox_receipts")
}
